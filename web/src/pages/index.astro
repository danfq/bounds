---
import MainLayout from "@/layouts/main.astro"
import { InteractiveGridPattern } from "@/components/ui/interactive-grid-pattern"
import { cn } from "@/lib/utils"
import { CodeBlock } from "@/components/custom/code"
import { HomeGetStarted } from "@/components/custom/pages/home/get-started"
---

<MainLayout title="Bounds">
  <div
    class="relative z-0 flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden bg-background pt-20"
  >
    <InteractiveGridPattern
      client:load
      className={cn("inset-0 z-0 h-full w-full skew-y-12")}
      squaresClassName="hover:fill-accent border-text-muted-foreground! transition-all duration-100 ease-in-out"
    />

    <div
      class="pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center gap-8 backdrop-blur-sm"
    >
      {/* title */}
      <div class="flex flex-col items-center justify-center gap-3">
        <h1 class="text-4xl font-bold">define your project's <span class="text-accent">bounds</span> in seconds</h1>
        <p>
          the fastest way to add a <CodeBlock code="LICENSE" /> and <CodeBlock code=".gitignore" /> to your project
        </p>
      </div>

      {/* get started */}
      <div class="pointer-events-auto flex items-center justify-center gap-2">
        <HomeGetStarted client:load />
      </div>
    </div>
  </div>
</MainLayout>
