---
import MainLayout from "@/layouts/main.astro"
import { HomeGetStarted } from "@/components/custom/pages/home/get-started"
import { InteractiveGridPattern } from "@/components/ui/interactive-grid-pattern"
import { cn } from "@/lib/utils"
import { version } from "../../package.json"
import { CodeBlock } from "@/components/custom/code"
---

<MainLayout title="Bounds">
  <div
    class="relative z-0 flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden bg-background pt-16 sm:pt-20"
  >
    <InteractiveGridPattern
      client:load
      className={cn("inset-0 z-0 h-full w-full skew-y-12")}
      squaresClassName="hover:fill-accent border-text-muted-foreground! transition-all duration-100 ease-in-out"
    />

    <div
      class="pointer-events-none absolute inset-0 z-10 flex min-w-0 flex-col items-center justify-center gap-7 px-4 pt-16 backdrop-blur-sm sm:gap-8 sm:px-6 sm:pt-20"
    >
      {/* title */}
      <div class="flex w-full max-w-4xl min-w-0 flex-col items-center justify-center gap-3 text-center">
        <h1 class="text-3xl leading-[1.05] font-bold text-balance sm:text-4xl">
          define your project's <span class="text-accent">bounds</span> in seconds
        </h1>
        <p class="max-w-xl leading-relaxed text-pretty">
          the fastest way to add a <CodeBlock code="LICENSE" /> and <CodeBlock code=".gitignore" /> to your project
        </p>
      </div>

      {/* get started */}
      <div class="pointer-events-auto flex w-full min-w-0 flex-col items-center justify-center gap-2">
        {/* current version */}
        <p class="text-xs text-muted-foreground">v{version}</p>
        <HomeGetStarted client:load />
      </div>
    </div>
  </div>
</MainLayout>
