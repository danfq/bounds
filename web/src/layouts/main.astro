---
import "@/styles/global.css"
import Header from "@/components/custom/header.astro"
import { cn } from "@/lib/utils"
import { THEME_HEAD_INLINE_SCRIPT } from "@/lib/hooks/theme"
import { TooltipProvider } from "@/components/ui/tooltip"

export interface Props {
  title?: string
  className?: string
  class?: string
}

const { title, className, class: bodyClassFromAttr } = Astro.props
const isDev = import.meta.env.DEV
---

<html class="scroll-smooth">
  <head>
    <script is:inline set:html={THEME_HEAD_INLINE_SCRIPT} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="preload"
      href="/static/fonts/Figtree_Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <style is:inline>
      @font-face {
        font-family: "Figtree Variable";
        font-style: normal;
        font-weight: 300 900;
        font-display: block;
        src: url("/static/fonts/Figtree_Variable.woff2") format("woff2");
      }
    </style>
    {isDev ? <script>import "@vitejs/plugin-react/preamble";</script> : null}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class={cn(
      "flex min-h-dvh flex-col overflow-hidden",
      className,
      bodyClassFromAttr
    )}
  >
    <TooltipProvider>
      <script>
        import { initThemeDocument } from "@/lib/hooks/theme"
        initThemeDocument()
      </script>
      <Header title={title} />
      <main class="flex min-h-0 min-w-0 flex-1 flex-col">
        <slot />
      </main>
    </TooltipProvider>
  </body>
</html>
